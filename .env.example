# Public build-time setting; every VITE_ variable is visible to browser users.
VITE_API_BASE_URL=/api

# Public beta UI: 20 MiB upload notice and 24-hour retention disclosure.
# Must match the server's enabled production beta policy. No secrets belong here.
VITE_PUBLIC_BETA=false

# Development proxy only; evaluated in Vite's Node process, not bundled for browsers.
DEV_API_PROXY_TARGET=http://127.0.0.1:3000
